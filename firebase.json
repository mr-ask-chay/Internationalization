{
  "hosting": [
    {
      "target": "dev",
      "public": "dist/internationalization",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "/en/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/robots.txt",
          "destination": "/en/robots.txt"
        },
        {
          "source": "/sitemap.xml",
          "destination": "/en/assets/sitemap.xml"
        },
        {
          "source": "/en/**",
          "destination": "/en/index.html"
        },
        {
          "source": "/nl/**",
          "destination": "/nl/index.html"
        },
        {
          "source": "/sr/**",
          "destination": "/sr/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "prod",
      "public": "dist/internationalization",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "/en/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/robots.txt",
          "destination": "/en/robots.txt"
        },
        {
          "source": "/sitemap.xml",
          "destination": "/en/assets/sitemap.xml"
        },
        {
          "source": "/en/**",
          "destination": "/en/index.html"
        },
        {
          "source": "/nl/**",
          "destination": "/nl/index.html"
        },
        {
          "source": "/sr/**",
          "destination": "/sr/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
